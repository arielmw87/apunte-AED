% ============================================================
%  Latch D con habilitación (EN) — diagrama + símbolo (figura 7.10 Floyd)
%  Es un latch SR con habilitación al que se le agrega un INVERSOR:
%  la entrada de datos D va directo a la NAND superior, y su negada
%  (Dbar) a la inferior. Así nunca se da la combinación no válida del SR.
%    NAND superior = NAND(D, EN)      NAND inferior = NAND(Dbar, EN)
%  Con EN=1 la salida Q sigue a D; con EN=0 el latch MANTIENE el dato.
% ============================================================
%  CÓMO AJUSTAR:
%   - Columnas de compuertas: la x de (ns)/(nr)=0 y (nq)/(nqb)=3
%   - Altura de las filas:     el y=±1.3
%   - Posición del inversor:   la coordenada de (inv)
%   - Posición del símbolo:    el shift={(8.5,0)}
%   NOTA: cruces de cable sin punto NO conectan; el punto (\circ) sí.
% ============================================================
\begin{circuitikz}[transform shape, scale=0.72]

  % ----- AND de entrada (gobernadas por EN) -----
  \node[ieeestd and port] (ns) at (0, 1.5) {};
  \node[ieeestd and port] (nr) at (0,-1.5) {};
  % ----- Latch NOR acoplado en cruz -----
    \node[ieeestd nor port] (nq) at (3, 1.2) {};   % salida Q
    \node[ieeestd nor port] (nqb) at (3,-1.2) {};   % salida Qbar
  % ----- Inversor -----
    \node[ieeestd not port,rotate=270, scale=0.75] (inv) at (-2.5,0.0) {};   % inversor: Dbar = NOT(D)


  % Entrada D
  \draw (ns.in 1) --++(-1.4,0) coordinate(inva)--++(-1.,0) node[left]{\small D};
  \draw (inva) -- (inv.in);
  \node[circ] at (inva){};   
  \draw (inv.out) |- (nr.in 2);
  

  % EN: una sola línea vertical que alimenta las dos NAND de entrada
  \draw (ns.in 2) -- ++(-0.5,0) coordinate(ens);
  \draw (nr.in 1) -- ++(-0.5,0) coordinate(enr);
  \draw (ens) -- (enr);
  \draw (ens) -- ++(-1.9,0) node[left]{\small EN};
  \node[circ] at (ens){};   

  % Latch con NORS
  \draw (nq.in  1) -- (ns.out);
  \draw (nqb.in 2) -- (nr.out);
  \draw (nq.out) -- ++(0.2,0) coordinate(qnq) -- ++(0.6,0) node[right]{\small $\overline{Q}$}            ;
  \draw (nqb.out) -- ++(0.2,0) coordinate(qnqb) -- ++(0.6,0) node[right]{\small $Q$} ;
  \node[circ] at (qnq){};   
  \node[circ] at (qnqb){};
  \draw (qnq) -- ++(0,-0.5) --++(-2.5,-1) |- (nqb.in 1);
  \draw (qnqb) -- ++(0, 0.5) --++(-2.5, 1) |- (nq.in 2);

  % ----- Símbolo en bloque -----
  \begin{scope}[shift={(8.5,0)}]
    \draw[thick] (-0.95,-1.5) rectangle (0.95,1.5);
    \draw (-0.95, 0.8) node[right]{\small D} -- ++(-0.9,0) ;
    \draw (-0.95, 0.0) node[right]{\small EN} -- ++(-0.9,0) ;
    \draw ( 0.95, 0.8) node[left]{\small $\overline{Q}$} -- ++(0.9,0)  ;
    \draw ( 0.95,-0.8) node[left]{\small $Q$} -- ++(0.9,0)  ;
  \end{scope}

\end{circuitikz}



