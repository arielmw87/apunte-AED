% ============================================================
%  Latch SR con habilitación (EN): diagrama de tiempos
%  - Con EN=1 el latch responde a S y R como un latch SR común.
%  - Con EN=0 (zona sombreada) las entradas se IGNORAN: Q mantiene.
%  - R sube en t=5 (con EN=0) y recién actúa cuando EN vuelve a 1 (t=8).
%  Coordenadas: ver tikz/estilos.tex (1 carácter = 1 unidad en x).
% ============================================================
\begin{tikztimingtable}[timing/aed]
  EN  & 4H 4L 4H \\
  $S$ & 2L 2H 8L \\
  $R$ & 5L 5H 2L \\
  $Q$ & 2L 6H 4L \\
  \extracode
    \begin{pgfonlayer}{background}
      \fill[zona] (4,1.2) rectangle (8,{-3*\rowdist-0.2});
      \vertlines{2,4,5,8,10}
    \end{pgfonlayer}
    \foreach \x/\op in {1/Hold, 3/SET, 6/bloqueado, 9/RESET, 11/Hold}
      \node[fase] at (\x,1.5) {\op};
    \node[nota] at (0,{-3*\rowdist-1.1})
      {R sube en $t{=}5$, pero el latch lo ignora hasta que EN vuelve a 1 ($t{=}8$).};
\end{tikztimingtable}
