% ============================================================
%  Latch SR con habilitación (EN) — diagrama + símbolo (figura 7.8 Floyd)
%  Estructura con 4 NAND:
%    - 2 NAND de entrada gobernadas por EN:  NAND(S,EN) y NAND(R,EN)
%    - 1 latch NAND acoplado en cruz que guarda el estado.
%  Con EN=0 las NAND de entrada dan 1 y el latch MANTIENE el dato.
%  Con EN=1 el latch sigue a S/R.
% ============================================================
%  CÓMO AJUSTAR:
%   - Columnas de compuertas: la x de (ns)/(nr)=0 y (nq)/(nqb)=3
%   - Altura de las filas:     el y=±1.3
%   - Posición del símbolo:    el shift={(8.5,0)}
%   - Tamaño del lazo:         los ++(0,±3.4) y ++(-4.x,0)
%   NOTA: cruces de cable sin punto NO conectan; el punto (\circ) sí.
% ============================================================
\begin{circuitikz}[transform shape, scale=0.72]

  % ----- AND de entrada (gobernadas por EN) -----
  \node[ieeestd and port] (ns) at (0, 1.5) {};
  \node[ieeestd and port] (nr) at (0,-1.5) {};
  % ----- Latch NOR acoplado en cruz -----
    \node[ieeestd nor port] (nq) at (3, 1.2) {};   % salida Q
    \node[ieeestd nor port] (nqb) at (3,-1.2) {};   % salida Qbar

  % Entradas S y R
  \draw (ns.in 1) -- ++(-1.4,0) node[left]{\small R};
  \draw (nr.in 2) -- ++(-1.4,0) node[left]{\small S};
  % EN: una sola línea vertical que alimenta las dos NAND de entrada
  \draw (ns.in 2) -- ++(-0.5,0) coordinate(ens);
  \draw (nr.in 1) -- ++(-0.5,0) coordinate(enr);
  \draw (ens) -- (enr);
  \draw ($(ens)!0.5!(enr)$) -- ++(-0.9,0) node[left]{\small EN};
  \node[circ] at ($(ens)!0.5!(enr)$){};   
  %\node[circ] at (enr){};

  % Latch con NORS
  \draw (nq.in  1) -- (ns.out);
  \draw (nqb.in 2) -- (nr.out);
  \draw (nq.out) -- ++(0.2,0) coordinate(qnq) -- ++(0.6,0) node[right]{\small $Q$}            ;
  \draw (nqb.out) -- ++(0.2,0) coordinate(qnqb) -- ++(0.6,0) node[right]{\small $\overline{Q}$} ;
  \node[circ] at (qnq){};   
  \node[circ] at (qnqb){};
  \draw (qnq) -- ++(0,-0.5) --++(-2.5,-1) |- (nqb.in 1);
  \draw (qnqb) -- ++(0, 0.5) --++(-2.5, 1) |- (nq.in 2);

  % ----- Símbolo en bloque -----
  \begin{scope}[shift={(10,0)}]
    \draw[thick] (-0.95,-1.5) rectangle (0.95,1.5);
    \draw (-0.95, 0.9) node[right]{\small S} -- ++(-0.9,0) ;
    \draw (-0.95, 0.0) node[right]{\small EN} -- ++(-0.9,0) ;
    \draw (-0.95,-0.9) node[right]{\small R} -- ++(-0.9,0) ;
    \draw ( 0.95, 0.9) node[left]{\small $Q$} -- ++(0.9,0)  ;
    \draw ( 0.95,-0.9) node[left]{\small $\overline{Q}$} -- ++(0.9,0)  ;
  \end{scope}

\end{circuitikz}
