% ============================================================
%  Latch SR (entradas activas en ALTO): diagrama de tiempos
%  - S=1 pone Q=1 (SET); R=1 pone Q=0 (RESET); S=R=0 mantiene (Hold).
%  - Q arranca desconocido (X) hasta la primera orden.
%  Coordenadas: ver tikz/estilos.tex (1 carácter = 1 unidad en x).
% ============================================================
\begin{tikztimingtable}[timing/aed]
  $S$            & 2L 2H 8L \\
  $R$            & 8L 2H 2L \\
  $Q$            & 2X 6H 4L \\
  $\overline{Q}$ & 2X 6L 4H \\
  \extracode
    \begin{pgfonlayer}{background}
      \vertlines{2,4,8,10}
    \end{pgfonlayer}
    % operación en cada intervalo (arriba de la primera señal)
    \foreach \x/\op in {1/Hold, 3/SET, 6/Hold, 9/RESET, 11/Hold}
      \node[fase] at (\x,1.5) {\op};
\end{tikztimingtable}
