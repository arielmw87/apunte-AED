% ============================================================
%  Latch D con habilitación: diagrama de tiempos
%  - EN=1: el latch es "transparente", Q copia a D.
%  - EN=0 (zona sombreada): Q retiene el último valor, aunque D cambie.
%  Coordenadas: ver tikz/estilos.tex (1 carácter = 1 unidad en x).
% ============================================================
\begin{tikztimingtable}[timing/aed]
  EN  & 4H 4L 4H \\
  $D$ & 2L 4H 4L 2H \\
  $Q$ & 2L 6H 2L 2H \\
  \extracode
    \begin{pgfonlayer}{background}
      \fill[zona] (4,1.2) rectangle (8,{-2*\rowdist-0.2});
      \vertlines{2,4,6,8,10}
    \end{pgfonlayer}
    \node[fase] at (2, 1.5) {$Q=D$};
    \node[fase] at (6, 1.5) {$Q$ retiene};
    \node[fase] at (10,1.5) {$Q=D$};
    \node[nota] at (0,{-2*\rowdist-1.1})
      {En $t{=}6$, D baja a 0 pero Q no cambia porque EN=0.};
\end{tikztimingtable}
