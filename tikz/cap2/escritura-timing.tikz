% ============================================================
%  Diagrama de tiempos: operación de ESCRITURA en una memoria
%  Los números en círculo son los pasos del texto:
%   1) dirección en el bus   2) CS en bajo   3) dato en el bus
%   4) pulso bajo en WE -> el dato se graba en el flanco de SUBIDA de WE.
%  OE permanece en alto (salidas deshabilitadas) durante toda la escritura.
%  Z = alta impedancia (nadie maneja el bus de datos).
%  Coordenadas: ver tikz/estilos.tex (1 carácter = 1 unidad en x).
% ============================================================
%  CÓMO AJUSTAR:
%   - Instantes de cada paso: los números de las filas (2U 10D..., 3H 8L ...)
%     y la lista \x/\n de los círculos (deben coincidir).
%   - Ancho total: timing/xunit en las opciones de la tabla.
% ============================================================
\begin{tikztimingtable}[timing/aed,
    paso/.style={circle, fill=teal!60!black, text=white, inner sep=0.8pt,
                 font=\sffamily\scriptsize\bfseries, minimum size=3.6mm}]
  Dirección                 & 2U 10D{Dirección válida} 2U \\
  $\overline{\text{CS}}$    & 3H 8L 3H \\
  Datos                     & 4Z 7D{Dato a escribir} 3Z \\
  $\overline{\text{WE}}$    & 5H 4L 5H \\
  $\overline{\text{OE}}$    & 14H \\
  \extracode
    \begin{pgfonlayer}{background}
      \vertlines{2,3,4,5,9}
    \end{pgfonlayer}
    % pasos del texto
    \foreach \x/\n in {2/1, 3/2, 4/3, 5/4}
      \node[paso] at (\x,1.9) {\n};
    \node[fase] at (9,1.6) {se graba el dato};
    \draw[->, >=Stealth, teal!60!black, line width=0.7pt]
      (9.9,{-3*\rowdist+0.5}) node[right, font=\sffamily\scriptsize]{flanco $\uparrow$}
      -- (9.15,{-3*\rowdist+0.5});
    \node[nota] at (0,{-4*\rowdist-1.1})
      {$\overline{\text{OE}}$ queda en alto: durante la escritura la memoria no maneja el bus de datos.};
\end{tikztimingtable}
