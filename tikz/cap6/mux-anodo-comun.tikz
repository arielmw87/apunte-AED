% ============================================================
%  Multiplexado con CONEXIÓN DIRECTA, sin transistores
%  (ejemplo con displays de ÁNODO COMÚN; usar transistores o no es
%   independiente del tipo de display, ver mux-displays.tikz)
%  - Cada ánodo común va al pin del micro (PC0..PC3) a través de UNA
%    resistencia, que limita la corriente total del dígito.
%  - Los segmentos van directo a los pines del micro (sin resistencias).
%  - Selección activa en ALTO: PCn = 1 alimenta el ánodo -> dígito encendido.
%  - Segmentos activos en BAJO: un segmento se enciende con su pin en 0
%    -> en el código se escribe el patrón invertido: mostrar(~patron).
%  - Problema: la corriente de la única resistencia se REPARTE entre los
%    segmentos encendidos -> puede haber diferencias de brillo entre
%    segmentos y entre dígitos (un "8" más tenue que un "1").
%  El dígito se dibuja con el pic "sieteseg" (tikz/estilos.tex).
% ============================================================
%  CÓMO AJUSTAR:
%   - Separación entre displays:        \paso
%   - Altura del bus de segmentos:      \ybus (abajo)
%   - Altura de las resistencias de ánodo: \yan
%   - Valor de las resistencias:        el l= de los to[R, ...]
% ============================================================
\begin{circuitikz}[
    scale=0.85, transform shape,
    sel/.style={font=\sffamily\scriptsize, inner sep=1pt},
    nota/.style={font=\sffamily\scriptsize, text=teal!60!black},
  ]
  \def\paso{3.3}
  \def\ybus{-1.6}
  \def\yan{2.6}

  % --- 1) Los 4 displays (el ánodo común queda ARRIBA) ---
  \foreach \i in {0,1,2,3}{
    \node[display7] (d\i) at (\paso*\i,0) {};
    \pic at (d\i.center) {sieteseg};
    \node[sel, anchor=north west] at (d\i.south east) {DIG\i};
  }

  % --- 2) Una resistencia por ánodo, hacia el pin del micro ---
  \foreach \i in {0,1,2,3}{
    \draw (d\i.north) to[R, l_={\scriptsize 220\,$\Omega$}] (d\i.north |- 0,\yan)
          node[sel, above] {PC\i};
  }

  % --- 3) Bus de segmentos compartido (abajo), SIN resistencias ---
  \foreach \i in {0,1,2,3}{
    \draw (d\i.south) -- (d\i.south |- 0,\ybus);
    \node[circ] at (d\i.south |- 0,\ybus) {};
  }
  \draw[thick] (-1.6,\ybus) node[left, align=center, font=\sffamily\small]
        {segmentos\\a--g} -- (3*\paso+0.6,\ybus);
  \draw (-1.25,\ybus-0.15) -- (-1.0,\ybus+0.2);
  \node[sel] at (-0.95,\ybus+0.35) {7};

  % --- 4) Notas ---
  \node[nota, align=center] at (1.5*\paso,\ybus-0.85)
    {PC0--PC3 en 1: se enciende ese dígito. Segmento en 0: se enciende
     (se escribe {\ttfamily mostrar(\char126 patron)}).\\
     \textcolor{red!60!black}{Más simple, pero la corriente de cada resistencia se reparte
     entre los segmentos encendidos:}\\
     \textcolor{red!60!black}{puede haber diferencias de brillo.}};
\end{circuitikz}
