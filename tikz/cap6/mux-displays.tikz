% ============================================================
%  Multiplexado de 4 displays de 7 segmentos (cátodo común)
%  IDEA CLAVE:
%   1) Las 7 líneas de segmento (a–g) son COMPARTIDAS por los 4 displays
%      (bus superior, dibujado como una sola línea con la marca /7).
%      Salen del PORTD (PD0..PD6), igual que en el código del Cap. 6.
%   2) Cada display se enciende de a uno mediante su transistor de
%      selección de dígito, que conecta el cátodo común a masa.
%      Las compuertas salen de PB0..PB3 (SEL0..SEL3 en el código).
%   El micro rota DIG0->DIG1->DIG2->DIG3 muy rápido (>50 Hz) y el ojo
%   los ve a todos encendidos.
% ============================================================
%  CÓMO AJUSTAR:
%   - Cantidad/separación de displays: el \foreach y \paso
%   - Altura del bus de segmentos:     \ybus
%   - Altura del riel de masa:         \ymasa
%   - Tamaño general:                  scale= en \begin{tikzpicture}
% ============================================================
\begin{tikzpicture}[
    scale=0.9, transform shape,
    disp/.style={draw, thick, fill=gray!8, minimum width=1.15cm,
                 minimum height=1.25cm, font=\Large\bfseries},
    sel/.style={font=\sffamily\scriptsize, inner sep=1pt},
    >=Stealth
  ]
  \def\paso{2.8}
  \def\ybus{1.7}
  \def\ymasa{-3.0}

  % --- 1) Los 4 displays en fila ---
  \foreach \i in {0,1,2,3}{
    \node[disp] (d\i) at (\paso*\i,0) {8.};
    \node[sel, anchor=south west] at (d\i.north east) {DIG\i};
  }

  % --- 2) Bus de segmentos compartido (arriba) ---
  \draw[thick] (-1.6,\ybus) -- (3*\paso+0.6,\ybus);
  \node[left, align=center, font=\sffamily\small] at (-1.6,\ybus)
    {segmentos a--g\\{\scriptsize (PD0--PD6)}};
  \draw (-1.0,\ybus-0.15) -- (-0.75,\ybus+0.2);
  \node[sel] at (-0.7,\ybus+0.35) {7};
  \foreach \i in {0,1,2,3}{
    \draw (d\i.north) -- (d\i.north |- 0,\ybus);
    \node[circ] at (d\i.north |- 0,\ybus) {};
  }

  % --- 3) Transistor de selección de dígito bajo cada display ---
  \foreach \i in {0,1,2,3}{
    \node[nmos, anchor=D] (t\i) at (d\i.south |- 0,-1.15) {};
    \draw (t\i.D) -- (d\i.south);                 % cátodo común -> drenador
    \draw (t\i.S) -- (t\i.S |- 0,\ymasa);         % source -> riel de masa
    \draw (t\i.G) -- ++(-0.35,0) node[sel, left] {PB\i};
  }

  % --- 4) Riel de masa común ---
  \draw (t0.S |- 0,\ymasa) -- (3*\paso+0.6,\ymasa);
  \node[ground] at (3*\paso+0.6,\ymasa) {};

  % --- 5) Nota de la selección de dígito ---
  \node[align=center, font=\sffamily\scriptsize] at (1.4*\paso,\ymasa-0.95)
    {PB0--PB3: selección de dígito (desde el micro) --- se activa uno a la vez};

\end{tikzpicture}
